<%
String rememberMe = CookiesManagerUtil.getCookieValue(CookiesConstants.NAME_REMEMBER_ME, request);

// In FIPS mode the idle timeout is configured by the Crypto Officer, and the
// FIPS session lifetime filter publishes the value it applied to the session.
// Falling back to the web.xml value would have the browser call
// "/c/portal/expire_session" at the shorter container default and invalidate a
// session the server was still willing to keep.

int sessionLength = GetterUtil.getInteger(request.getAttribute(WebKeys.FIPS_SESSION_IDLE_TIMEOUT), PropsValues.SESSION_TIMEOUT * 60);
%>

<c:if test="<%= !themeDisplay.isSignedIn() || Validator.isNull(rememberMe) %>">
	<aui:script type="module">
		import {Session} from '<%= FrontendESMUtil.buildURL(themeDisplay, "frontend-js-web", "legacy") %>';

		if (Liferay.Session && Liferay.Session.destructor) {
			Liferay.Session.destructor();
		}

		Liferay.Session = new Session(
			{
				autoExtend: <%= !themeDisplay.isSignedIn() || SessionTimeoutUtil.isAutoExtend(request) %>,
				redirectOnExpire: <%= SSOUtil.isSessionRedirectOnExpire(themeDisplay.getCompanyId()) %>,
				redirectUrl: '<%= HtmlUtil.escapeJS(SSOUtil.getSessionExpirationRedirectURL(themeDisplay.getCompanyId(), themeDisplay.getURLHome())) %>',
				rememberMe: <%= Validator.isNotNull(rememberMe) %>,
				sessionLength: <%= sessionLength %>,
				sessionTimeoutOffset: <%= SessionTimeoutUtil.getAutoExtendOffset(request) %>,
				warningLength: <%= PropsValues.SESSION_TIMEOUT_WARNING * 60 %>
			})
	</aui:script>
</c:if>